rules_version = '2';

// Regras de segurança do Firestore — Fase 0 da auditoria (rev. GREEN 2026-07-03,
// cobre as 4 condições do parecer YELLOW→GREEN + validações do snapshot de produção).
// Deploy: `firebase deploy --only firestore:rules` (precisa do firebase.json).
// ANTES de qualquer deploy: rodar a suite do emulador em `tests/firestore-rules/`
// (zero contato com produção — ver README de lá).
// Objetivo: dados privados por usuário; sessão de categorização acessível por
// quem tem o token (capability URL), mas com escrita pública restrita a poucos
// campos VALIDADOS e leitura das subcoleções bloqueada após a expiração.
service cloud.firestore {
  match /databases/{database}/documents {

    // O operador (IA) nunca é "dono" de nada: nem do próprio /users/{uid},
    // nem de sessão de categorização. Para o dono real isto não muda nada.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && !isOperator();
    }

    // ---- Usuário operador (IA) ----
    // UIDs como MARCADORES: o texto publicado é gerado fora do repositório
    // (repo público) trocando __OPERADOR_UID__ e __DONO_UID__. Publicado com os
    // marcadores, o operador não é ninguém (falha fechada). Se os dois UIDs
    // forem iguais, o operador também não é ninguém e o dono segue intacto.
    function isOperator() {
      return request.auth != null
        && request.auth.uid == '__OPERADOR_UID__'
        && '__OPERADOR_UID__' != '__DONO_UID__';
    }

    // Operador agindo SÓ na árvore do dono.
    function operatorOnOwner(uid) {
      return isOperator() && uid == '__DONO_UID__';
    }

    function nullOrCategoryId(v) {
      return v == null || (v is string && v.matches('^[A-Za-z0-9_-]{1,128}$'));
    }

    function nullOrDay(d, k) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= 1 && d[k] <= 31);
    }

    // ---- Tipos dos campos que o operador grava (F4-1) ----
    // Número finito com módulo até `max`. A faixa com os DOIS limites recusa
    // também NaN e ±Infinity: NaN falha nas comparações (e, na ordenação do
    // Firestore, fica abaixo de todo número), Infinity passa do limite. Não
    // usar math.abs (abs(NaN) é NaN) nem math.isInfinite (não existe no
    // emulador; os testes pegam NaN e Infinity pela faixa).
    function finiteNum(v, max) {
      return v is number && v >= -max && v <= max;
    }
    function strMax(v, max) {
      return v is string && v.size() <= max;
    }
    // Campo opcional: ausente, ou do tipo pedido. `Null` = aceita null também.
    function optStr(d, k, max) {
      return !(k in d) || strMax(d[k], max);
    }
    function optNullStr(d, k, max) {
      return !(k in d) || d[k] == null || strMax(d[k], max);
    }
    function optNullTs(d, k) {
      return !(k in d) || d[k] == null || d[k] is timestamp;
    }
    function optNullNum(d, k, max) {
      return !(k in d) || d[k] == null || finiteNum(d[k], max);
    }
    function optNullInt(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }
    function optNullMatch(d, k, re) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].matches(re));
    }

    // tags: lista de até 10 strings de até 50 caracteres. O app só grava []
    // hoje. As regras não têm laço, e join() converte número e null em texto
    // sem errar, então cada posição é checada.
    function tagAt(l, i) {
      return l.size() <= i || strMax(l[i], 50);
    }
    function tagsOk(l) {
      return l is list && l.size() <= 10
        && tagAt(l, 0) && tagAt(l, 1) && tagAt(l, 2) && tagAt(l, 3) && tagAt(l, 4)
        && tagAt(l, 5) && tagAt(l, 6) && tagAt(l, 7) && tagAt(l, 8) && tagAt(l, 9);
    }

    // Lançamento criado pelo operador: lista FECHADA de campos (a do app, sem
    // reembolso, noteAlert e pluggyTransactionId), carimbo import_<ms> ou null,
    // nunca já conciliado, e TODO campo com o tipo que o app grava. Campo
    // obrigatório ausente reprova pela checagem de tipo (ler campo inexistente
    // é erro, e erro nega). Nenhum campo do lançamento é mapa.
    function operatorTxOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'date', 'purchaseDate', 'description', 'amount', 'categoryId', 'account',
          'familyMember', 'titular', 'installmentNumber', 'totalInstallments',
          'cardNumber', 'projectId', 'tags', 'notes', 'importBatch', 'reconciled',
          'reconciledAt', 'createdAt', 'billingMonth', 'provisionalDate', 'fitid',
          'amountFx', 'currencyFx', 'fxRate'])
        && d.date is timestamp
        && d.createdAt is timestamp
        && strMax(d.description, 500)
        && finiteNum(d.amount, 100000000)
        && strMax(d.account, 100) && d.account.size() > 0
        && (!('categoryId' in d) || nullOrCategoryId(d.categoryId))
        && optNullMatch(d, 'projectId', '^[A-Za-z0-9_-]{1,128}$')
        && optNullTs(d, 'purchaseDate')
        && optNullTs(d, 'provisionalDate')
        && optStr(d, 'familyMember', 100)
        && optStr(d, 'titular', 100)
        && optStr(d, 'notes', 500)
        && optNullStr(d, 'cardNumber', 32)
        && optNullStr(d, 'fitid', 255)
        && optNullInt(d, 'installmentNumber', 1, 99)
        && optNullInt(d, 'totalInstallments', 1, 99)
        && optNullMatch(d, 'billingMonth', '^[0-9]{4}-(0[1-9]|1[0-2])$')
        && optNullNum(d, 'amountFx', 100000000)
        && optNullMatch(d, 'currencyFx', '^[A-Z]{3}$')
        && (!('fxRate' in d) || d.fxRate == null || (finiteNum(d.fxRate, 1000) && d.fxRate > 0))
        && (!('tags' in d) || tagsOk(d.tags))
        && (!('importBatch' in d) || d.importBatch == null
            || (d.importBatch is string && d.importBatch.matches('^import_[0-9]{10,}$')))
        && (!('reconciled' in d) || d.reconciled == false)
        && (!('reconciledAt' in d) || d.reconciledAt == null);
    }

    // Conta criada pelo operador: só os campos de Account, cada um com o tipo
    // do app. Nenhum campo da conta é mapa.
    function operatorAccountOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'type', 'bank', 'closingDay', 'dueDay', 'creditLimit', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.type in ['corrente', 'cartao', 'beneficio', 'poupanca', 'investimento', 'outro']
        && d.createdAt is timestamp
        && optStr(d, 'bank', 100)
        && nullOrDay(d, 'closingDay')
        && nullOrDay(d, 'dueDay')
        && (!('creditLimit' in d) || d.creditLimit == null
            || (finiteNum(d.creditLimit, 100000000) && d.creditLimit >= 0));
    }

    // Só os campos em `allowed` foram alterados nesta escrita.
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function session(token) {
      return get(/databases/$(database)/documents/categorizationSessions/$(token)).data;
    }

    function isSessionOwner(token) {
      return isOwner(session(token).userId);
    }

    function sessionNotExpired(token) {
      return request.time < session(token).expiresAt;
    }

    // ---- Dados privados do usuário: só o próprio dono ----
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
      // Operador: só LÊ a árvore do dono.
      allow read: if operatorOnOwner(uid);
    }

    // Operador: cria lançamento novo (create só vale para doc que não existe)
    // e troca SÓ o categoryId de um existente, para uma categoria que existe
    // (ou null). Nunca delete; nada de importBatch em linha existente.
    match /users/{uid}/transactions/{txId} {
      allow create: if operatorOnOwner(uid) && operatorTxOk();
      allow update: if operatorOnOwner(uid)
        && changedOnly(['categoryId'])
        && nullOrCategoryId(request.resource.data.categoryId)
        && (request.resource.data.categoryId == null
            || exists(/databases/$(database)/documents/users/$(uid)/categories/$(request.resource.data.categoryId)));
    }

    // Operador: só cria conta nova. Nome inédito é checagem do escritor.
    match /users/{uid}/accounts/{accountId} {
      allow create: if operatorOnOwner(uid) && operatorAccountOk();
    }

    // ---- Sessões de categorização (acesso público por token) ----
    match /categorizationSessions/{token} {
      // `get` fica aberto DE PROPÓSITO: a página pública precisa ler o doc da
      // sessão mesmo expirado para mostrar "este link expirou" (o doc só tem
      // metadados; os dados financeiros vivem nas subcoleções, que TÊM check
      // de expiração abaixo). `list` só o dono: as rules avaliam a query, então
      // só passa um list cujo filtro garanta userId == request.auth.uid —
      // bloqueia a enumeração de tokens por conta autenticada qualquer.
      allow get: if !isOperator();
      allow list: if request.auth != null && !isOperator() && resource.data.userId == request.auth.uid;

      // Criação: só autenticado E em nome de quem cria (bloqueia forja de
      // sessão apontando para o userId de outra conta). Os campos dos quais as
      // regras abaixo dependem precisam nascer com o tipo certo.
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.transactionIds is list;
      allow delete: if isOwner(resource.data.userId);

      // Dono edita à vontade — é por AQUI que o apply renova `expiresAt`
      // (lastActivityAt + 48h) e o reopenSession dá +48h: renovação de prazo
      // é escrita do DONO, nunca do público. Público (quem tem o link) só
      // mexe nos contadores, só enquanto o link é válido, e com tipo/faixa
      // validados — inclusive via increment() atômico: as rules avaliam
      // request.resource.data já com o field transform aplicado, então o
      // VALOR RESULTANTE do increment precisa cair no range. `expiresAt`
      // fica FORA da allow-list pública → imutável (ninguém estende o próprio
      // prazo com o token); idem `status`, `applied*` e `transactionIds`.
      allow update: if isOwner(resource.data.userId)
        || (!isOperator()
            && changedOnly(['categorizedCount', 'lastActivityAt'])
            && request.time < resource.data.expiresAt
            && request.resource.data.categorizedCount is int
            && request.resource.data.categorizedCount >= 0
            && request.resource.data.categorizedCount <= resource.data.transactionIds.size()
            && request.resource.data.lastActivityAt is timestamp);

      // Categorias copiadas para a sessão: leitura pública só enquanto o link
      // vale (o dono lê sempre); escrita só do dono da sessão-pai.
      match /categories/{catId} {
        allow read: if isSessionOwner(token) || (!isOperator() && sessionNotExpired(token));
        allow write: if isSessionOwner(token);
      }

      // Transações da sessão: leitura pública só enquanto o link vale; o dono
      // lê SEMPRE (o apply do delta pode acontecer depois da expiração —
      // applyAllPendingSessions varre sessões 'active' já expiradas).
      // O dono cria/apaga/edita tudo (create/delete presos ao dono da
      // sessão-pai — conta estranha não forja transação em sessão alheia).
      // O público só grava categoryId/notes validados e applied=false:
      // categorizar/desfazer sempre escreve applied:false no app; applied=true
      // é exclusivo do apply do dono — quem tem o token não consegue fazer o
      // apply pular itens. O dono também marca `applied:true, orphaned:true`
      // nas transações reais já excluídas (C3 — consome o delta órfão);
      // `orphaned` fica FORA da allow-list pública.
      match /transactions/{txId} {
        allow read: if isSessionOwner(token) || (!isOperator() && sessionNotExpired(token));
        allow create, delete: if isSessionOwner(token);
        allow update: if isSessionOwner(token)
          || (!isOperator()
              && changedOnly(['categoryId', 'notes', 'applied'])
              && sessionNotExpired(token)
              && (request.resource.data.categoryId == null
                  || (request.resource.data.categoryId is string
                      && request.resource.data.categoryId.size() <= 128))
              && request.resource.data.notes is string
              && request.resource.data.notes.size() <= 500
              && request.resource.data.applied == false);
      }
    }
  }
}
